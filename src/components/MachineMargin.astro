---
interface Props { lines: { text: string; href?: string }[] }
const { lines } = Astro.props;
---
<div>
  <aside class="ai" data-mm>
    <div class="head"><span>✦ MACHINE MARGIN</span><span>auto-generated</span></div>
    <div class="mm-body">
      {lines.map((l) => <div class="mm-line">{l.href ? <>→ <a href={l.href}>{l.text}</a></> : l.text}</div>)}
      <span class="cursor"></span>
    </div>
  </aside>
  <p class="fine">This margin fills itself in. Related notes are picked by how similar the writing is.</p>
</div>
