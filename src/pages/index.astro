---
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import MachineMargin from '../components/MachineMargin.astro';
import { allPosts, related, postUrl, SECTIONS } from '../lib/posts';

const posts = await allPosts();
const shelf = posts.filter((p) => p.data.category !== 'life');
const latest = shelf[0];
const margin = [
  { text: `> 최근 글 "${latest.data.title}"` },
  { text: '> 이 글과 이어지는 노트 3개를 찾았어요.' },
  ...related(latest, posts).map((p) => ({ text: p.data.title, href: postUrl(p) })),
];
---
<Base>
  <div class="hero">
    <section class="hero-left">
      <p class="kicker">Heather Shin — notes from a product-minded marketer</p>
      <h1>
        What happens when <span class="mark" data-annotate="circle" data-color="#C2553A">curiosity</span> meets
        <span class="end"><span class="mark" data-annotate="line" data-delay="1.5">execution</span>?<span class="aside" aria-hidden="true">
          <svg viewBox="0 0 56 44" fill="none" stroke="#3B4468" stroke-width="2" stroke-linecap="round"><path d="M53 36 C38 38, 18 28, 7 7" /><path d="M5 21 L7 7 L20 12" /></svg>
          <span>여기가 늘 출발점</span>
        </span></span>
      </h1>
      <p class="lede">공부한 것, 업계에서 본 것, 직접 만들어 본 것을 적어 둡니다. 다 쓴 글뿐 아니라 아직 자라는 중인 노트도 함께 둡니다.</p>
    </section>
    <aside class="hero-right">
      <div>
        <div class="label">최근에 쓴 노트</div>
        {shelf.slice(0, 3).map((p) => <PostRow post={p} show="stage" />)}
      </div>
      <MachineMargin lines={margin} />
    </aside>
  </div>

  <div class="shelf">
    {SECTIONS.map((s) => {
      const list = posts.filter((p) => p.data.category === s.category);
      return (
        <section>
          <h2>{s.title}</h2>
          <p>{s.blurb}</p>
          {list.slice(0, 4).map((p) => <PostRow post={p} />)}
          {list.length ? <a class="more" href={`/${s.slug}/`}>{list.length}편 모두 보기 →</a> : <div class="hand empty">곧 첫 기록이 올라옵니다</div>}
        </section>
      );
    })}
  </div>
</Base>

<style>
  .shelf :global(.note .stage) { display: none; }
</style>
