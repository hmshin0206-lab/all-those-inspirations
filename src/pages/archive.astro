---
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import { allPosts } from '../lib/posts';

const posts = await allPosts();
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))];
---
<Base title="Archive" description="Everything written since 2017.">
  <header class="page-head">
    <p class="kicker">All Those Inspirations</p>
    <h1><span class="mark" data-annotate="line">Archive</span><span class="hand">{years.at(-1)} — {years[0]}</span></h1>
    <p class="lede">All {posts.length} posts so far, including everyday and exhibition notes.</p>
  </header>
  {years.map((y) => (
    <section class="year">
      <span>{y}</span>
      <div>{posts.filter((p) => p.data.date.getFullYear() === y).map((p) => <PostRow post={p} category />)}</div>
    </section>
  ))}
</Base>
